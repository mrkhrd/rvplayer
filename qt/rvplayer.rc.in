// The program's icon and version information (configured by CMakeLists.txt).
#include <winver.h>

IDI_ICON1 ICON "@RV_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @RV_VERSION_COMMAS@
PRODUCTVERSION @RV_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RV Player - dashcam video, GPS and map player"
            VALUE "FileVersion", "@RV_VERSION@"
            VALUE "InternalName", "rvplayer"
            VALUE "OriginalFilename", "rvplayer.exe"
            VALUE "ProductName", "RV Player"
            VALUE "ProductVersion", "@RV_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
